<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template parent="AdwDialog" class="DanmakuSearchDialog">
    <property name="content-width">800</property>
    <property name="content-height">1000</property>
    <property name="title" translatable="yes">Search Danmaku</property>
    <child>
      <object class="AdwToastOverlay" id="toast">
        <child>
          <object class="AdwNavigationView" id="navigation_view">
            <child>
              <object class="AdwNavigationPage" id="page">
                <property name="tag">main</property>
                <property name="title" translatable="yes">Search Danmaku</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar"/>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">1</property>
                        <child>
                          <object class="AdwClamp">
                            <property name="margin-bottom">12</property>
                            <child>
                              <object class="GtkListBox">
                                <property name="valign">1</property>
                                <child>
                                  <object class="AdwEntryRow" id="title_entry">
                                    <property name="title" translatable="yes">Title</property>
                                    <signal name="entry-activated" handler="search_cb" swapped="yes"/>
                                    <child type="suffix">
                                      <object class="GtkDropDown" id="anime_type_dropdown">
                                        <property name="valign">center</property>
                                        <property name="selected">0</property>
                                        <property name="tooltip-text" translatable="yes">Anime Type</property>
                                        <property name="model">
                                          <object class="GtkStringList">
                                            <items>
                                              <item translatable="yes">TV Series</item>
                                              <item translatable="yes">TV Special</item>
                                              <item translatable="yes">OVA</item>
                                              <item translatable="yes">Movie</item>
                                              <item translatable="yes">Music Video</item>
                                              <item translatable="yes">Web</item>
                                              <item translatable="yes">Other</item>
                                              <item translatable="yes">Japanese Movie</item>
                                              <item translatable="yes">Japanese Drama</item>
                                              <item translatable="yes">TMDB TV</item>
                                              <item translatable="yes">TMDB Movie</item>
                                            </items>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child type="suffix">
                                      <object class="GtkStack" id="search_stack">
                                        <property name="valign">fill</property>
                                        <property name="transition-type">crossfade</property>
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">search</property>
                                            <property name="child">
                                              <object class="GtkButton">
                                                <property name="valign">3</property>
                                                <property name="icon-name">edit-find-symbolic</property>
                                                <property name="action-name">danmaku-search-dialog.search</property>
                                                <property name="tooltip-text" translatable="yes">Search</property>
                                                <style>
                                                  <class name="accent"/>
                                                  <class name="circular"/>
                                                </style>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">loading</property>
                                            <property name="child">
                                              <object class="AdwSpinner"/>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <style>
                                  <class name="boxed-list-separate"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="TuViewScrolled" id="view">
                            <property name="vexpand">True</property>
                            <property name="unify-size">ForcePost</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwNavigationPage" id="episodes_page">
                <property name="tag">episodes</property>
                <property name="title" translatable="yes">Episodes</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar"/>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <child>
                          <object class="GtkListBox" id="episode_list">
                            <property name="selection-mode">none</property>
                            <property name="margin-start">18</property>
                            <property name="margin-end">18</property>
                            <property name="margin-top">18</property>
                            <property name="margin-bottom">18</property>
                            <style>
                              <class name="boxed-list-separate"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
